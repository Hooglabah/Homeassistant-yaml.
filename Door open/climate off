blueprint:
  name: Door Left Open - Climate Off & Restore
  description: >-
    Sends phone alerts when a door is left open, turns off specific climate zones
    after a delay, and restores them when the door closes. Designed for parallel
    tracking of multiple doors.
  domain: automation
  author: User
  input:
    door_sensor:
      name: Door Sensor
      description: The binary sensor for the door (e.g., binary_sensor.door_1).
      selector:
        entity:
          domain: binary_sensor
    door_name:
      name: Friendly Door Name
      description: Name used in notifications (e.g., "Master Bedroom").
      default: Unknown Door
      selector:
        text:
    climate_entities:
      name: Climate Entities to Control
      description: >-
        List of climate entities to turn off (e.g., climate.mainbedroom).
        Include shared zones like kitchen/living if applicable.
      selector:
        entity:
          domain: climate
          multiple: true
    warn_delay:
      name: Warning Delay (Minutes)
      description: Time before sending the first warning notification.
      default: 15
      selector:
        number:
          min: 1
          max: 120
          unit_of_measurement: minutes
          mode: box
    off_delay:
      name: Shutoff Delay (Minutes)
      description: Total time before turning off climate (must be > Warning Delay).
      default: 30
      selector:
        number:
          min: 2
          max: 240
          unit_of_measurement: minutes
          mode: box
    notify_service:
      name: Notification Service
      description: >-
        The notify service to use (e.g., notify.mobile_app_your_phone).
        Enter the full service name.
      selector:
        text:
    enable_hvac_gate:
      name: Only Run If HVAC Is Active
      description: >-
        If checked, the automation only runs if at least one climate entity
        is currently in heat/cool mode.
      default: true
      selector:
        boolean:

variables:
  door_sensor: !input door_sensor
  door_name: !input door_name
  climate_entities: !input climate_entities
  warn_delay: !input warn_delay
  off_delay: !input off_delay
  notify_service: !input notify_service
  enable_hvac_gate: !input enable_hvac_gate
  wait_time: "{{ [off_delay | int - warn_delay | int, 1] | max }}"

trigger:
  - platform: state
    entity_id: !input door_sensor
    from: "off"
    to: "on"
    for:
      minutes: !input warn_delay

condition:
  - condition: template
    value_template: >-
      {% if not enable_hvac_gate %}
        true
      {% else %}
        {% set active_modes = ['heat', 'cool', 'heat_cool', 'dry', 'fan_only'] %}
        {% for entity_id in climate_entities %}
          {% if states(entity_id) in active_modes %}
            {{ true }}
          {% endif %}
        {% endfor %}
        false
      {% endif %}

action:
  # Snapshot current states for restoration
  - variables:
      snapshot: >-
        {% set ns = namespace(data=[]) %}
        {% for ent in climate_entities %}
          {% set ns.data = ns.data + [{'entity_id': ent, 'state': states(ent)}] %}
        {% endfor %}
        {{ ns.data }}

  # --- STEP 1: WARNING NOTIFICATION ---
  - service: "{{ notify_service }}"
    data:
      title: "Door Open Alert: {{ door_name }}"
      message: >-
        The {{ door_name }} door has been open for {{ warn_delay }} minutes.
        Climate will turn off in {{ wait_time }} minutes if it remains open.

  # --- STEP 2: WAIT FOR DOOR TO CLOSE OR TIMEOUT ---
  - wait_for_trigger:
      - platform: state
        entity_id: !input door_sensor
        from: "on"
        to: "off"
    timeout:
      minutes: "{{ wait_time }}"
    continue_on_timeout: true

  # --- STEP 3: DECIDE ACTION ---
  - choose:
      # Case A: Door still open -> Turn Off
      - conditions:
          - condition: template
            value_template: "{{ is_state(door_sensor, 'on') }}"
        sequence:
          - service: climate.turn_off
            target:
              entity_id: "{{ climate_entities }}"
          - service: "{{ notify_service }}"
            data:
              title: "Climate Turned Off: {{ door_name }}"
              message: >-
                The {{ door_name }} door was open for {{ off_delay }} minutes.
                Climate has been turned off for: {{ climate_entities | join(', ') }}.

      # Case B: Door closed -> Restore
      - conditions:
          - condition: template
            value_template: "{{ is_state(door_sensor, 'off') }}"
        sequence:
          - repeat:
              for_each: "{{ snapshot }}"
              sequence:
                - choose:
                    # Restore to HVAC mode if it was active
                    - conditions:
                        - condition: template
                          value_template: >-
                            {{ repeat.item.state in ['heat', 'cool', 'heat_cool', 'dry', 'fan_only', 'auto'] }}
                      sequence:
                        - service: climate.set_hvac_mode
                          target:
                            entity_id: "{{ repeat.item.entity_id }}"
                          data:
                            hvac_mode: "{{ repeat.item.state }}"
                    # Otherwise, ensure it stays off
                    - condition: template
                      value_template: "{{ true }}"
                    sequence:
                      - service: climate.turn_off
                        target:
                          entity_id: "{{ repeat.item.entity_id }}"
          - service: "{{ notify_service }}"
            data:
              title: "Door Closed: {{ door_name }}"
              message: >-
                The {{ door_name }} door was closed. Climate restored for:
                {{ climate_entities | join(', ') }}.

mode: single
max_exceeded: silent
