blueprint:
  name: Door Left Open - Climate Off & Restore
  description: >-
    Sends phone alerts when a door is left open, turns off specific climate zones
    after a delay, and restores them when the door closes.
  domain: automation
  author: User
  input:
    door_sensor:
      name: Door Sensor
      description: The binary sensor for the door.
      selector:
        entity:
          domain: binary_sensor
          device_class: door
    door_name:
      name: Friendly Door Name
      description: Name used in notifications.
      default: Unknown Door
      selector:
        text:
    climate_entities:
      name: Climate Entities to Control
      description: List of climate entities to turn off.
      selector:
        entity:
          domain: climate
          multiple: true
    warn_delay:
      name: Warning Delay (Minutes)
      description: Time before sending the first warning notification.
      default: 15
      selector:
        number:
          min: 1
          max: 120
          unit_of_measurement: minutes
          mode: box
    off_delay:
      name: Shutoff Delay (Minutes)
      description: Total time before turning off climate.
      default: 30
      selector:
        number:
          min: 2
          max: 240
          unit_of_measurement: minutes
          mode: box
    notify_service:
      name: Notification Service
      description: The notify service to use (e.g., notify.mobile_app_your_phone).
      selector:
        text:
    enable_hvac_gate:
      name: Only Run If HVAC Is Active
      description: If checked, only runs if climate is active.
      default: true
      selector:
        boolean:

variables:
  door_sensor: !input - binary_sensor.door_sensor
  door_name: !input door_name
  climate_entities: !input climate_entities
  warn_delay: !input warn_delay
  off_delay: !input off_delay
  notify_service: !input notify_service
  enable_hvac_gate: !input enable_hvac_gate
  wait_time: "{{ [off_delay | int - warn_delay | int, 1] | max }}"
  # Capture initial states as a list of strings "entity|state"
  initial_states: >-
    {% set ns = namespace(res=[]) %}
    {% for e in climate_entities %}
      {% set ns.res = ns.res + [e ~ '|' ~ states(e)] %}
    {% endfor %}
    {{ ns.res | join(',') }}

trigger:
  - platform: state
    entity_id: !input door_sensor
    from: "off"
    to: "on"
    for:
      minutes: !input warn_delay

condition:
  - condition: template
    value_template: >-
      {% if not enable_hvac_gate %}
        true
      {% else %}
        {% set active_modes = ['heat', 'cool', 'heat_cool', 'dry', 'fan_only'] %}
        {% for entity_id in climate_entities %}
          {% if states(entity_id) in active_modes %}
            {{ true }}
          {% endif %}
        {% endfor %}
        false
      {% endif %}

action:
  # --- STEP 1: WARNING NOTIFICATION ---
  - service: "{{ notify_service }}"
    data:
      title: "Door Open Alert: {{ door_name }}"
      message: >-
        The {{ door_name }} door has been open for {{ warn_delay }} minutes.
        Climate will turn off in {{ wait_time }} minutes if it remains open.

  # --- STEP 2: WAIT ---
  - wait_for_trigger:
      - platform: state
        entity_id: !input door_sensor
        from: "on"
        to: "off"
    timeout:
      minutes: "{{ wait_time }}"
    continue_on_timeout: true

  # --- STEP 3: CHOOSE ---
  - choose:
      # Case A: Still Open -> Turn Off
      - conditions:
          - condition: template
            value_template: "{{ is_state(door_sensor, 'on') }}"
        sequence:
          - service: climate.turn_off
            target:
              entity_id: "{{ climate_entities }}"
          - service: "{{ notify_service }}"
            data:
              title: "Climate Turned Off: {{ door_name }}"
              message: >-
                The {{ door_name }} door was open for {{ off_delay }} minutes.
                Climate turned off.

      # Case B: Closed -> Restore
      - conditions:
          - condition: template
            value_template: "{{ is_state(door_sensor, 'off') }}"
        sequence:
          - repeat:
              for_each: "{{ initial_states.split(',') }}"
              sequence:
                - variables:
                    parts: "{{ repeat.item.split('|') }}"
                    entity: "{{ parts[0] }}"
                    old_state: "{{ parts[1] }}"
                - choose:
                    - conditions:
                        - condition: template
                          value_template: "{{ old_state in ['heat', 'cool', 'heat_cool', 'dry', 'fan_only', 'auto'] }}"
                      sequence:
                        - service: climate.set_hvac_mode
                          target:
                            entity_id: "{{ entity }}"
                          data:
                            hvac_mode: "{{ old_state }}"
                    - conditions:
                        - condition: template
                          value_template: "{{ true }}"
                      sequence:
                        - service: climate.turn_off
                          target:
                            entity_id: "{{ entity }}"
          - service: "{{ notify_service }}"
            data:
              title: "Door Closed: {{ door_name }}"
              message: >-
                The {{ door_name }} door was closed. Climate restored.

mode: single
max_exceeded: silent
